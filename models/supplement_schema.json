{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D&D 2024 Supplement Package Schema",
  "description": "Schema for modular 1st and 3rd party D&D 2024 supplement packages.",
  "type": "object",
  "required": ["manifest"],
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["id", "title", "version", "compatibility"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Canonical unique slug identifier for the supplement (e.g. 'kobold-tome-of-heroes')"
        },
        "title": {
          "type": "string",
          "description": "Human-readable title (e.g. 'Tome of Heroes')"
        },
        "publisher": {
          "type": "string",
          "description": "Publisher or author name (e.g. 'Kobold Press')"
        },
        "version": {
          "type": "string",
          "description": "Semantic version (e.g. '1.0.0')"
        },
        "compatibility": {
          "type": "string",
          "description": "Target D&D ruleset compatibility, e.g. '2024'"
        },
        "description": {
          "type": "string",
          "description": "Summary of what this supplement adds"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of prerequisite supplements required by this package"
        },
        "url": {
          "type": "string",
          "description": "Optional website or store link"
        }
      },
      "additionalProperties": true
    },
    "classes": {
      "type": "array",
      "items": { "$ref": "class_schema.json" },
      "description": "New classes added by this supplement"
    },
    "subclasses": {
      "type": "array",
      "items": { "$ref": "subclass_schema.json" },
      "description": "New subclasses added by this supplement"
    },
    "species": {
      "type": "array",
      "items": { "$ref": "species_schema.json" },
      "description": "New species added by this supplement"
    },
    "species_variants": {
      "type": "array",
      "items": { "$ref": "species_variant_schema.json" },
      "description": "New species lineages/variants added by this supplement"
    },
    "backgrounds": {
      "type": "array",
      "items": { "$ref": "background_schema.json" },
      "description": "New backgrounds added by this supplement"
    },
    "feats": {
      "type": "object",
      "properties": {
        "origin_feats": {
          "type": "object",
          "description": "Map of origin feat names to feat definitions"
        },
        "general_feats": {
          "type": "object",
          "description": "Map of general feat names to feat definitions"
        }
      },
      "additionalProperties": false
    },
    "eldritch_invocations": {
      "$ref": "eldritch_invocation_schema.json",
      "description": "New eldritch invocations added by this supplement"
    },
    "spells": {
      "type": "array",
      "items": { "$ref": "spell_schema.json" },
      "description": "New spell definitions added by this supplement"
    },
    "spell_class_lists": {
      "type": "object",
      "description": "Additions to class spell lists, keyed by class name (e.g. 'wizard')",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cantrips": { "type": "array", "items": { "type": "string" } },
          "spells_by_level": { "type": "object" }
        }
      }
    },
    "equipment": {
      "type": "object",
      "properties": {
        "weapons": { "type": "object" },
        "armor": { "type": "object" },
        "weapon_masteries": { "type": "object" },
        "adventuring_gear": { "type": "object" }
      }
    }
  },
  "additionalProperties": false
}
