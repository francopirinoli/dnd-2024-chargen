  "features_by_level": {
    "1": {
      "Spellcasting": {
        "description": "You have learned to cast spells through study of arcane magic. You know three Wizard cantrips (Light, Mage Hand, and Ray of Frost are recommended). Your spellbook starts with six level 1 Wizard spells (Detect Magic, Feather Fall, Mage Armor, Magic Missile, Sleep, and Thunderwave are recommended). You prepare spells from your spellbook and can change your prepared spells when you finish a Long Rest.",
        "feature_kind": "spellcasting_setup"
      },
      "Ritual Adept": "You can cast any spell as a Ritual if that spell has the Ritual tag and the spell is in your spellbook. You needn't have the spell prepared, but you must read from the book to cast a spell in this way.",
      "Arcane Recovery": "When you finish a Short Rest, you can choose expended spell slots to recover. The spell slots can have a combined level equal to no more than half your Wizard level (round up), and none of the slots can be level 6 or higher. Once you use this feature, you can't do so again until you finish a Long Rest."
    },
    "2": {
      "Scholar": {
        "description": "Choose one of the following skills in which you have proficiency: Arcana, History, Investigation, Medicine, Nature, or Religion. You have Expertise in the chosen skill.",
        "choices": {
          "type": "select_single",
          "count": 1,
          "name": "wizard_scholar_skill",
          "source": {
            "type": "fixed_list_intersect_proficiencies",
            "options": [
              "Arcana",
              "History",
              "Investigation",
              "Medicine",
              "Nature",
              "Religion"
            ]
          }
        },
        "effects": [
          {
            "type": "grant_skill_expertise",
            "from_choice": "wizard_scholar_skill"
          }
        ]
      }
    },
    "3": {
      "Wizard Subclass": {
        "description": "You gain a Wizard subclass of your choice. A subclass is a specialization that grants you features at certain Wizard levels.",
        "feature_kind": "subclass_pick"
      }
    },
    "4": {
      "Ability Score Improvement": {
        "description": "You gain the Ability Score Improvement feat or another feat of your choice for which you qualify.",
        "choices": {
          "name": "class_feat_4",
          "source": {
            "type": "external",
            "file": "general_feats.json",
            "list": "general_feats"
